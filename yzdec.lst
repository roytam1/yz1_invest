.data:0040A014 aAYzdecFilename db '       : A> yzdec FileName.yz1     '
.data:0040A014 db '      (Extract an archive ',27h,'FileN'
.data:0040A014 db 'ame.yz1',27h,')',0Ah
.data:0040A014 db '       : A> yzdec -d FileName.yz1  '
.data:0040A014 db '      (Extract an archive ',27h,'FileN'
.data:0040A014 db 'ame.yz1',27h,' and put it into a folde'
.data:0040A014 db 'r you like.)',0Ah
.data:0040A014 db '       : A> yzdec -dC:\TMP\ FileNam'
.data:0040A014 db 'e.yz1 (Extract and put extracted fi'
.data:0040A014 db 'le(s) into a folder',27h,'C:\TMP\',27h,')'
.data:0040A014 db 0Ah
.data:0040A014 db '       : A> yzdec -pPASSWD FileName'
.data:0040A014 db '.yz1  (Extract by using password ',27h
.data:0040A014 db 'PASSWD',27h,')',0Ah
.data:0040A014 db '       : A> yzdec -y FileName.yz1  '
.data:0040A014 db '      (Program automatically choose'
.data:0040A014 db 's [Yes] at all inquires in a proces'
.data:0040A014 db 's.)',0Ah
.data:0040A014 db '       : A> yzdec -t FileName.yz1  '
.data:0040A014 db '      (Test an archive ',27h,'FileName'
.data:0040A014 db '.yz1',27h,' without extracting.)',0Ah
.data:0040A014 db '       : A> yzdec -j FileName.yz1  '
.data:0040A014 db '      (Japanese message.)',0
